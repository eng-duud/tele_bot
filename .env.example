# ==============================================================================
# Django Configuration
# ==============================================================================
DJANGO_SECRET_KEY=change-this-in-production-to-a-very-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# Database Configuration (Neon PostgreSQL or local)
USE_POSTGRES=True
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ==============================================================================
# Redis & Celery Configuration
# ==============================================================================
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ==============================================================================
# Telegram Bots Configuration
# ==============================================================================
# Customer Bot Token (From @BotFather)
CUSTOMER_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_customer

# Admin Bot Token (From @BotFather)
ADMIN_BOT_TOKEN=987654321:ZYXwvUTSRqpONmlKJIhgfeDCBA_admin

# Private Admin Telegram Group ID (where approval cards and alerts are sent, e.g. -1001234567890)
ADMIN_GROUP_ID=-1001234567890

# Public Success Channel ID or username (e.g. @MyStoreReceipts or -1009876543210)
SUCCESS_CHANNEL_ID=@YourStoreSuccessChannel

# Root Super Admin Telegram User ID (numeric, e.g. 12345678)
SUPER_ADMIN_TELEGRAM_ID=12345678

# ==============================================================================
# Data Encryption (Fernet Key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==============================================================================
DATA_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_FERNET_GENERATE_KEY

# ==============================================================================
# Cloudinary Configuration (Image & File storage)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================================================
# Store Defaults
# ==============================================================================
DEFAULT_EXCHANGE_RATE_USD_TO_YER=550.00
BASE_CURRENCY=YER
