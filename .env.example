# ==============================================================================
# 1. إعدادات خادم دجانغو الأساسية (Django Core Settings)
# ==============================================================================
DJANGO_SECRET_KEY=change-this-in-production-to-a-very-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# ==============================================================================
# 2. قاعدة البيانات السحابية (PostgreSQL / Neon Database)
# ==============================================================================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ==============================================================================
# 3. خادم المهام الخلفية والكاش (Redis & Celery)
# ==============================================================================
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ==============================================================================
# 4. بوتات تيليجرام وحسابات الإدارة (Telegram Bots & Management)
# ==============================================================================
# توكن بوت العملاء الرئيسي (من BotFather)
CUSTOMER_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_customer

# توكن بوت الإدارة ولوحة التحكم (من BotFather)
ADMIN_BOT_TOKEN=987654321:ZYXwvUTSRqpONmlKJIhgfeDCBA_admin

# معرف المدير العام المالك (Super Admin Telegram ID)
SUPER_ADMIN_TELEGRAM_ID=12345678

# معرف قروب المشرفين الخاص (تصل إليه إشعارات الطلبات والشحن والموافقة الفورية)
ADMIN_GROUP_ID=-1001234567890

# ==============================================================================
# 5. مفتاح تشفير المخزون والبيانات الحساسة (Fernet Data Encryption Key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==============================================================================
DATA_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_FERNET_GENERATE_KEY

# ==============================================================================
# 6. مزودات الـ API الخارجية (External Providers - اختياري)
# ==============================================================================
# VENTE_BASE_URL=https://ventetelegrambotrailway-production.up.railway.app
# VENTE_API_KEY=your_vente_api_key_here

# ==============================================================================
# 📌 ملاحظة معمارية هامة (Dynamic Dashboard Settings):
# ==============================================================================
# العناصر التالية يتم التحكم بها ديناميكياً 100% من لوحة تحكم بوت الإدارة:
# 1. قناة الاشتراك الإجباري (معرف القناة، الرابط، وتفعيل/تعطيل الإجبار)
# 2. قناة التفعيلات الناجحة (معرف القناة، الرابط، وتفعيل النشر التلقائي للعمليات)
# 3. العملة الرسمية الأساسية للمتجر (تبديل فوري بين الـ YER والـ USD بنقرة زر)
# 4. سعر صرف الدولار مقابل الريال اليمني (USD -> YER) مع تحديث فوري لأسعار المعروضات
# ==============================================================================
