# ==============================================================================
# 1. إعدادات خادم دجانغو الأساسية (Django Core Settings)
# ==============================================================================
DJANGO_SECRET_KEY=change-this-in-production-to-a-very-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# ==============================================================================
# 2. قاعدة البيانات السحابية (PostgreSQL / Neon Database)
# ==============================================================================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ==============================================================================
# 3. خادم المهام الخلفية والكاش (Redis & Celery)
# ==============================================================================
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ==============================================================================
# 4. بوتات تيليجرام وحسابات الإدارة (Turnkey Bot Setup)
# ==============================================================================
# كل ما يحتاجه العميل لتشغيل المتجر بالكامل هو هذه الـ 3 بيانات فقط:
# 1. توكن بوت المتجر والعملاء الرئيسي (من @BotFather)
CUSTOMER_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_customer

# 2. توكن بوت الإدارة ولوحة التحكم (من @BotFather)
ADMIN_BOT_TOKEN=987654321:ZYXwvUTSRqpONmlKJIhgfeDCBA_admin

# 3. آيدي المطور / المدير العام المالك (Super Admin Telegram ID من @userinfobot)
SUPER_ADMIN_TELEGRAM_ID=12345678

# ==============================================================================
# 5. مفتاح تشفير المخزون والبيانات الحساسة (Fernet Data Encryption Key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==============================================================================
DATA_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_FERNET_GENERATE_KEY

# ==============================================================================
# 6. مزودات الـ API الخارجية (External Providers - اختياري)
# ==============================================================================
# VENTE_BASE_URL=https://ventetelegrambotrailway-production.up.railway.app
# VENTE_API_KEY=your_vente_api_key_here

# ==============================================================================
# 📌 ملاحظة معمارية هامة (Zero-Code Dynamic Channels):
# ==============================================================================
# القنوات لا تحتاج لأي تعديل في الأكواد أو الملفات، بل يتم إدارتها بالكامل من بوت الأدمن:
# 1. 📢 قناة البوت الرسمية (تحديد المعرف وتفعيل/تعطيل الاشتراك الإجباري)
# 2. ⚡ قناة التفعيلات والمبيعات (نشر العمليات تلقائياً وتفعيل/تعطيل الاشتراك الإجباري)
# 3. 🎧 قناة/قروب الدعم الفني (استقبال الرسائل وتوجيه الردود للعملاء آلياً)
# 4. 🛡️ قروب إشعارات الإدارة (تنبيهات الإيداع والعمليات الفورية)
# 5. ➕ قنوات اشتراك إجباري إضافية (إضافة/حذف أي رعاة أو شركاء)
# ==============================================================================
